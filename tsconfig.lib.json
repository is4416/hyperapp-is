{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/hyperapp-is/index.ts",
    "src/hyperapp-is/core/*.ts",
    "src/hyperapp-is/animation/index.ts",
    "src/hyperapp-is/animation/raf.ts",
    "src/hyperapp-is/animation/easing.ts",
    "src/hyperapp-is/animation/properties.ts",
    "src/hyperapp-is/animationView/*.ts",
    "src/hyperapp-is/dom/index.ts",
    "src/hyperapp-is/dom/utils.ts"
  ]
}