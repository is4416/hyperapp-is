{
	"compilerOptions": {
		/* Language */
		"target": "ES2022",

		/* Modules */
		"module": "ESNext",
		"moduleResolution": "bundler",

		/* Output */
		"rootDir": ".",
		"outDir": "./dist",

		/* Type Declarations */
		"declaration": true,
		"declarationMap": false,

		/* Debug */
		"sourceMap": false,

		/* Type Checking */
		"strict": true,
		"skipLibCheck": true,

		/* Interop */
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}